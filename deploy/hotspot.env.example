# Copy, fill in, and keep OUT of the repository. install.sh writes this to
# deploy-state/hotspot.env with mode 600.
#
# Model transport. install.sh appends ARXIV_ASSISTANT_LLM_BACKEND itself, set
# to what the host can actually carry -- leave that line alone unless you know
# the host has the provider CLIs.
OPENAI_BASE_URL=replace-me
# Authenticate with ONE of these two.
#
# OPENAI_API_KEY is the ordinary Bearer credential the SDK sends by itself.
#
# OPENAI_EXTRA_HEADERS is for a gateway that wants something else, which is
# common and not exotic: an Azure API Management front end answers a Bearer
# request with 401 "Access denied due to missing subscription key". Give it a
# JSON object and those headers go on every request; the API key is then
# unnecessary and may be left empty.
#
# QUOTE IT. This file is sourced by the shell, not parsed as dotenv, so bash
# strips the double quotes out of a bare JSON value and the header arrives as
# {Ocp-Apim-Subscription-Key:...} -- unparseable, and reported as such by the
# installer's selftest rather than as a silent 401 every night.
#
#   OPENAI_EXTRA_HEADERS='{"Ocp-Apim-Subscription-Key":"...","user":"..."}'
OPENAI_API_KEY=
OPENAI_EXTRA_HEADERS=

# Publishing. Without a credential the run still generates and records
# "publish": "no-credential" rather than pretending it shipped.
#
# Prefer the deploy key. A classic PAT with `repo` is read/write on EVERY
# repository the account can reach and `workflow` can rewrite CI; a deploy key
# is one repository, revocable on its own, and its private half never leaves
# this host. Register the public half with:
#
#   gh repo deploy-key add <path>.pub --allow-write --title "<host>"
GIT_PUSH_SSH_KEY=
GIT_PUSH_TOKEN=
GIT_REPO_SLUG=DaizeDong/Daily-ArXiv-Assistant

# Model id. The environment wins over configs/config.ini on purpose: which
# models exist is a property of the gateway, and a deployment reinstalls
# itself with `git reset --hard`, so a model edited into the repo file is
# gone at the next install.
ARXIV_ASSISTANT_LLM_MODEL=

# Generation mode: auto uses agents where available, heuristic calls no model.
HOTSPOT_MODE=auto

# Optional source keys. Absent means that source is skipped, not that the run
# fails.
TWITTERAPI_IO_KEY=
X_BEARER_TOKEN=
